########################################
# Required server-only configuration
########################################
# PostgreSQL. Render can inject this from its managed PostgreSQL service.
DATABASE_URL=postgresql://user:password@host:5432/clipforge

# Groq is required for Whisper transcription and is the primary analyzer.
GROQ_API_KEY=
# Optional analysis fallback. Leave blank only if Groq will be used alone.
OPENROUTER_API_KEY=
# Optional direct Gemini analysis key (+ GEMINI_TEXT_MODEL, see below).
GEMINI_API_KEY=
# Optional ADDITIONAL OpenAI-compatible provider (NVIDIA NIM). Not the
# foundation — it only enters the fallback order when ANALYSIS_PROVIDERS
# lists "nvidia" and both values are set.
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Cloudflare R2 S3 credentials. Create an R2 API token with Object Read & Write
# permission for my-clips-storage. These values must never use NEXT_PUBLIC_ names.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=my-clips-storage
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Public origin of this same application (no trailing slash).
FRONTEND_URL=https://your-clipforge-service.onrender.com

########################################
# Music Library — Backblaze B2 (optional but required for music)
########################################
# A SEPARATE permanent bucket for the Music Library only.
# Cloudflare R2 keeps owning videos, sources, clips, posters and jobs.
# These values are server-only. Never prefix them with NEXT_PUBLIC_.
B2_ENDPOINT=https://s3.ca-east-006.backblazeb2.com
B2_REGION=ca-east-006
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_MUSIC_BUCKET=clipforge-music

# Bulk music upload tuning (safe defaults for a small instance).
MUSIC_UPLOAD_CONCURRENCY=2
MUSIC_MAX_FILES_PER_BATCH=25
MUSIC_PAGE_SIZE=24

########################################
# Optional tuning (safe defaults shown)
########################################
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GEMINI_TEXT_MODEL=
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
# The exact AI analysis fallback order: providers are tried in this list's
# order; unknown entries are dropped and unconfigured ones are skipped.
ANALYSIS_PROVIDERS=gemini,openrouter,groq,nvidia
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=ClipForge

########################################
# Shared audio layer (Movie Explainer + Documentary narration/music)
########################################
# Narration provider order. "mock" is ONLY honored when AUDIO_MOCK=1.
#   gemini → uses GEMINI_API_KEY above (Gemini TTS)
#   fish   → uses FISH_API_KEY below (Fish Audio TTS)
#   openai → uses OPENAI_API_KEY below (OpenAI-compatible /audio/speech)
# Production example: AUDIO_TTS_PROVIDERS=gemini,fish (Gemini primary, Fish fallback)
AUDIO_TTS_PROVIDERS=gemini,openai
# Background music provider order for the new modes.
#   b2        → existing Backblaze B2 Music Library (preferred)
#   freetouse → public Free To Use music library (no API key required)
AUDIO_MUSIC_PROVIDERS=b2,freetouse
# Testing only: enable the offline mock providers (sine-tone audio, no network).
AUDIO_MOCK=0

# Gemini TTS (reuses GEMINI_API_KEY / GEMINI_BASE_URL).
TTS_GEMINI_MODEL=gemini-2.5-flash-preview-tts
TTS_GEMINI_VOICE=Puck
# OpenAI-compatible TTS (documented endpoint POST /audio/speech).
OPENAI_API_KEY=
OPENAI_TTS_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# Fish Audio TTS (documented endpoint POST /v1/tts; model is an HTTP header).
FISH_API_KEY=
FISH_TTS_BASE_URL=https://api.fish.audio
FISH_TTS_MODEL=s2.1-pro-free
# Optional Fish voice model id (reference_id). Empty = Fish's default voice.
FISH_TTS_VOICE=
# Free To Use public music library (https://api.freetouse.com/v3 — no key).
FREETOUSE_BASE_URL=https://api.freetouse.com/v3
AUDIO_REQUEST_TIMEOUT_SEC=180

# Target narration lengths (UI can override per job).
MOVIE_TARGET_SEC=90
DOC_TARGET_SEC=120

# Ephemeral scratch space used only during active FFmpeg jobs.
STORAGE_DIR=/tmp/clipforge
RETENTION_HOURS=24
MIN_FREE_DISK_MB=1500
CLEANUP_INTERVAL_MINUTES=15

MAX_UPLOAD_MB=400
MAX_DURATION_MINUTES=120
MAX_URL_SIZE_MB=800
URL_DOWNLOAD_TIMEOUT_SEC=600
ALLOW_YTDLP=false

AUDIO_CHUNK_SEC=600
AUDIO_CHUNK_OVERLAP_SEC=1.5
TRANSCRIBE_TIMEOUT_SEC=600
ANALYSIS_TIMEOUT_SEC=180
ANALYSIS_MAX_RETRIES=2
# Bounded provider-chain passes per structured-JSON request (1-3). Pass 1
# tries every configured provider once; a second pass runs only for
# deterministic schema failures or transient overload. Never remove.
ANALYSIS_CHAIN_PASSES=2
# Output token budget for story-part analysis. Reasoning models (gpt-oss,
# gemini-2.5-flash) spend part of this budget on hidden reasoning, so keep
# headroom for the JSON answer itself (default 2048).
ANALYSIS_STORY_OUTPUT_TOKENS=2048
# Output token budget for the Movie Explainer script (five sections with
# narration). Defaults to 3200 — 1800 truncated real scripts in production.
ANALYSIS_SCRIPT_OUTPUT_TOKENS=3200
# Groq gpt-oss reasoning budget: minimal|low|medium|high. "low" keeps hidden
# reasoning tokens small so the constrained JSON fits the output budget.
GROQ_REASONING_EFFORT=low

TARGET_WIDTH=1080
TARGET_HEIGHT=1920
TARGET_FPS=30
VIDEO_CRF=23
VIDEO_PRESET=veryfast
AUDIO_BITRATE_K=128

# Keep at 1 unless the server has enough CPU/RAM for parallel FFmpeg jobs.
MAX_CONCURRENT_JOBS=1
DEFAULT_CLIP_COUNT=3
MAX_CLIP_COUNT=8
MIN_CLIP_SEC=12
MAX_CLIP_SEC=90
DATABASE_POOL_MAX=10

# Docker sets these. Only set manually for a non-Docker deployment.
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
